# ==============================================================================
# JARVIS X OS — Environment Configuration Template
# Copy this file to .env and configure local secrets / endpoints.
# NEVER COMMIT .env OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Profile & Operating Mode
# ------------------------------------------------------------------------------
# Profile options: development | testing | production
JARVIS_ENV=development

# Operating Mode options: offline | online | hybrid
#   offline: 100% local operation (no external cloud requests)
#   online : cloud AI enabled (external endpoints permitted)
#   hybrid : smart routing between local and cloud models
JARVIS_MODE=hybrid

# Debug logging and verbosity
JARVIS_DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Network Configuration & Ports
# ------------------------------------------------------------------------------
# Local loopback binding recommended for development and security
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
HUD_PORT=5173
HUD_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Local AI Engine (Ollama / Local Inference)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0.7

# Local Specialized Model Roles
LOCAL_GENERAL_MODEL=qwen2.5-coder:7b
LOCAL_FAST_MODEL=qwen2.5:1.5b
LOCAL_REASONING_MODEL=deepseek-r1:7b
LOCAL_CODING_MODEL=qwen2.5-coder:7b
LOCAL_VISION_MODEL=moondream:latest

# ------------------------------------------------------------------------------
# 4. Cloud AI Providers (Online / Hybrid Mode Only)
# ------------------------------------------------------------------------------
# Set to false to prevent all cloud provider calls
CLOUD_PROVIDER_ENABLED=false

# OpenAI / OpenAI-Compatible (DeepSeek, Groq, Together, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash

# Groq (Ultra-Fast Inference)
GROQ_API_KEY=

# Cloud Specialized Model Roles
CLOUD_GENERAL_MODEL=gpt-4o-mini
CLOUD_REASONING_MODEL=o3-mini
CLOUD_CODING_MODEL=claude-3-5-sonnet-20241022
CLOUD_FAST_MODEL=gpt-4o-mini
CLOUD_VISION_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 5. Hybrid Model Routing & Privacy Policy
# ------------------------------------------------------------------------------
# Routing preference: AUTO | LOCAL | CLOUD | HYBRID
MODEL_ROUTING_PREFERENCE=AUTO

# Privacy policy: PREFER_LOCAL | LOCAL_ONLY | CLOUD_ALLOWED
MODEL_PRIVACY_POLICY=PREFER_LOCAL

# ------------------------------------------------------------------------------
# 6. Feature Flags
# ------------------------------------------------------------------------------
VOICE_ENABLED=true
VISION_ENABLED=true
BROWSER_ENABLED=true
AUTOMATION_ENABLED=true
PLUGINS_ENABLED=true
MEMORY_ENABLED=true
PROACTIVE_MODE_ENABLED=true
LOCAL_AI_ENABLED=true
CLOUD_AI_ENABLED=false
HYBRID_MODE_ENABLED=true
DIAGNOSTICS_ENABLED=true
DEVELOPER_MODE=true

# ------------------------------------------------------------------------------
# 7. Resource Limits & Timeouts
# ------------------------------------------------------------------------------
LLM_TIMEOUT=60
TOOL_TIMEOUT=30
AGENT_TIMEOUT=120
BROWSER_TIMEOUT=30
MAX_CONCURRENT_AGENTS=4
MAX_TASK_DEPTH=2
MAX_TOOL_CALLS=20

# ------------------------------------------------------------------------------
# 8. Storage Paths & Obsidian Vault
# ------------------------------------------------------------------------------
VAULT_PATH=vault
SQLITE_DB_PATH=memory/database_storage/jarvis.sqlite
CHROMA_DB_PATH=memory/database_storage/chroma

# ------------------------------------------------------------------------------
# 9. Voice & Vision Interfaces
# ------------------------------------------------------------------------------
WAKE_WORD=jarvis
TTS_ENGINE=pyttsx3
STT_ENGINE=whisper
WHISPER_MODEL=base
ENERGY_THRESHOLD=300

VLM_MODEL=moondream
CAMERA_INDEX=0
TARGET_FPS=15
